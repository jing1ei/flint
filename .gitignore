# Dependencies
node_modules/

# Frontend build output
dist/

# Screenshots generated by UI tests. Regenerate them, do not commit them.
# This pattern matches a directory named exactly `shots`, so the curated, tracked images in
# docs/screenshots/ (the ones the README shows) are deliberately unaffected.
shots/

# Rust build output (one workspace target/ at the root; src-tauri has none of its own)
target/
**/*.rs.bk

# FFmpeg sidecars: fetched with scripts/fetch-sidecars.sh, never committed.
# They are large, platform specific and carry their own (GPL/LGPL) licence.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
src-tauri/licenses/WINDOWS-FFMPEG-*.txt

# Tauri generated
src-tauri/gen/

# macOS
.DS_Store
*.icloud

# Python byproducts (the drivers in scripts/)
__pycache__/
.venv/
*.py[cod]
.pytest_cache/
.ruff_cache/
.cache/
coverage/
*.profraw

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Logs / env
*.log
npm-debug.log*
.env
.env.local
.env.*

# TypeScript incremental build info
*.tsbuildinfo

# Locally built release artefacts. `npm run build:dmg` writes these inside target/ (already
# ignored); this catches a copy dragged out of it into the working tree before a hand-upload.
*.dmg
*.app.zip
SHA256SUMS.txt

# Editor/OS litter from contributors on other platforms
Thumbs.db
Desktop.ini

# Icon contact sheets and zooms: regenerate with scripts/make_icons.py --review
icon-review/
